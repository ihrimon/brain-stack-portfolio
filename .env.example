# Google Sheets integration (case studies data)
# See README.md "Case Studies via Google Sheets" section for full setup steps.
GOOGLE_SERVICE_ACCOUNT_EMAIL=agency-site@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-spreadsheet-id

# Contact form delivery (Gmail SMTP via nodemailer, see lib/actions/contact.ts)
# GMAIL_APP_PASSWORD is a Google Account "App Password", not the account's login password.
# Submissions are delivered TO this same address.
GMAIL_USER=your-inbox@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
